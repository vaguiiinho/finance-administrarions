# URL base da API (so servidor; o navegador nunca chama a API). O padrao do codigo e http://127.0.0.1:3001. Sem /api no final: o cliente acrescenta /api.
# A API escuta em PORT (padrao 3000 em api/src/main.ts) - e o `next dev` tambem usa 3000 -, entao rode a API com PORT=3001
# ou ajuste esta variavel para a porta escolhida.
API_URL=http://127.0.0.1:3001
# Producao (ADR 0011 6.1, N3): aponte API_URL para o listener INTERNO do nginx (rede do compose, sem ports:), nao para o host
# publico da API. O host publico (usado pelo app) bloqueia /api/admin/* e /api/demo/* (N4); o web usa as duas pelo listener interno.
# Nenhuma configuracao de nginx vive neste repositorio.

# E-mail de contato exibido em /support (so servidor; sem NEXT_PUBLIC_).
# OBRIGATORIA EM PRODUCAO: a App Store exige um contato de suporte acessivel. Sem ela o build/start emite um aviso e a pagina
# mostra um texto neutro, sem link (aceitavel apenas em desenvolvimento).
SUPPORT_EMAIL=suporte@example.com
