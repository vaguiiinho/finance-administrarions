# Conexão com o PostgreSQL (sem segredos reais)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance"
PORT=3000

# Segredo do HMAC do digest das sessões (obrigatório, no mínimo 32 bytes). Gere com: openssl rand -base64 48
# A API não sobe sem ele. Trocá-lo encerra todas as sessões.
SESSION_TOKEN_SECRET=

# Hops/redes confiáveis para ler o IP do cliente no X-Forwarded-For (padrão: "loopback, uniquelocal").
# A API não deve ser exposta publicamente: só o servidor do web a alcança.
# TRUST_PROXY="loopback, uniquelocal"

# Primeiro administrador. Só são lidas e exigidas enquanto o banco NÃO tiver nenhum usuário cadastrado;
# depois da primeira subida bem-sucedida podem ser removidas do ambiente. Nunca são logadas.
# O administrador criado por elas é obrigado a trocar a senha no primeiro acesso e recebe os dados já existentes.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Intervalo da manutenção periódica (dados de exemplo da demo e sessões expiradas), em ms. 0 desliga TAMBÉM a limpeza diária da
# conta de demonstração (03:00 America/Sao_Paulo); não use 0 em produção. Padrão: 3600000.
# MAINTENANCE_INTERVAL_MS=3600000

# Em produção a API fica atrás do nginx e TRUST_PROXY é OBRIGATÓRIA: somente o IP (ou sub-rede) do nginx,
# ex.: TRUST_PROXY="172.30.0.10". Valores como true, número de saltos, loopback e uniquelocal são recusados em
# NODE_ENV=production (o boot falha citando o nome da variável).

# App mobile: versão mínima aceita (X-Client: mobile/<versão>); abaixo dela a API responde 426 APP_UPDATE_REQUIRED.
# MOBILE_MIN_VERSION=1.0.0
# URL da App Store (https://) devolvida em details.storeUrl do 426.
# MOBILE_STORE_URL=

# Conta de demonstração do app (demo@showcase.invalid). Lida só pelo seed (a cada subida da imagem).
# Vazia/ausente = conta desligada (inativada se existir). 1 a 72 caracteres. Nunca é logada.
# Em produção, o valor é público por definição (notas de revisão da App Store) e não deve ser reutilizado.
# Onde a dica do web estiver ligada (DEMO_ACCOUNT_HINT=on), precisa valer `demo` (ADR 0013, R4). Com a conta ativa, o seed grava o
# dataset de exemplo e a rotina diária (03:00 America/Sao_Paulo) o restaura; manual: `npm run demo:reset` dentro do container.
SHOWCASE_ACCOUNT_PASSWORD=
