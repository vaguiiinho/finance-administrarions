# Conexão com o PostgreSQL (sem segredos reais)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance"
PORT=3000

# Segredo do HMAC do digest das sessões (obrigatório, no mínimo 32 bytes). Gere com: openssl rand -base64 48
# A API não sobe sem ele. Trocá-lo encerra todas as sessões.
SESSION_TOKEN_SECRET=

# Hops/redes confiáveis para ler o IP do cliente no X-Forwarded-For (padrão: "loopback, uniquelocal").
# A API não deve ser exposta publicamente: só o servidor do web a alcança.
# TRUST_PROXY="loopback, uniquelocal"

# Primeiro administrador. Só são lidas e exigidas enquanto o banco NÃO tiver nenhum usuário cadastrado;
# depois da primeira subida bem-sucedida podem ser removidas do ambiente. Nunca são logadas.
# O administrador criado por elas é obrigado a trocar a senha no primeiro acesso e recebe os dados já existentes.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Intervalo da manutenção periódica (dados de exemplo da demo e sessões expiradas), em ms. 0 desliga. Padrão: 3600000.
# MAINTENANCE_INTERVAL_MS=3600000
