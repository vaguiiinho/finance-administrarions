generator client {
  provider = "prisma-client"
  output   = "../src/shared/infrastructure/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum EntryType {
  INCOME
  EXPENSE

  @@map("entry_type")
}

enum PaymentMethod {
  PIX
  CARD

  @@map("payment_method")
}

enum EntryStatus {
  PENDING
  PAID
  RECEIVED

  @@map("entry_status")
}

enum UserKind {
  REGULAR
  /// Legado da demonstração pública (ADR 0013). O valor não é removível do tipo do PostgreSQL; proibido por users_kind_not_demo_chk.
  DEMO
  PENDING_FIRST_ADMIN
  SHOWCASE

  @@map("user_kind")
}

enum UserRole {
  ADMIN
  USER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

model User {
  id                 String     @id @db.Uuid
  name               String     @db.VarChar(60)
  email              String     @unique(map: "users_email_uq") @db.VarChar(254)
  passwordHash       String?    @map("password_hash") @db.VarChar(255)
  kind               UserKind   @default(REGULAR)
  role               UserRole   @default(USER)
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  createdAt          DateTime   @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @map("updated_at") @db.Timestamptz(3)
  sessions           Session[]
  cards              Card[]
  entries            Entry[]
  dataReset          OwnerDataReset?

  @@index([role, status], map: "users_role_status_idx")
  @@map("users")
}

model Session {
  id          String   @id @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  tokenDigest String   @unique(map: "sessions_token_digest_uq") @map("token_digest") @db.Char(64)
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([userId], map: "sessions_user_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

/// Controle da redefinição de dados por dono (ADR 0013). Substitui demo_datasets.
model OwnerDataReset {
  ownerId         String    @id @map("owner_id") @db.Uuid
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  anchorMonth     DateTime? @map("anchor_month") @db.Date
  templateVersion Int?      @map("template_version")
  lastResetAt     DateTime  @map("last_reset_at") @db.Timestamptz(3)

  @@map("owner_data_resets")
}

model Card {
  id         String   @id @db.Uuid
  name       String   @db.VarChar(50)
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  nameKey    String   @map("name_key") @db.VarChar(100)
  closingDay Int      @map("closing_day") @db.SmallInt
  dueDay     Int      @map("due_day") @db.SmallInt
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @map("updated_at") @db.Timestamptz(3)
  entries    Entry[]

  @@unique([userId, nameKey], map: "cards_owner_name_key_uq")
  @@map("cards")
}

model Entry {
  id             String        @id @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  type           EntryType
  description    String        @db.VarChar(120)
  category       String        @db.VarChar(50)
  categoryKey    String        @map("category_key") @db.VarChar(100)
  date           DateTime      @db.Date
  amount         Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod @map("payment_method")
  cardId         String?       @map("card_id") @db.Uuid
  card           Card?         @relation(fields: [cardId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  closingDate    DateTime?     @map("closing_date") @db.Date
  dueDate        DateTime?     @map("due_date") @db.Date
  referenceMonth DateTime      @map("reference_month") @db.Date
  status         EntryStatus
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz(3)
  createdAt      DateTime      @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @map("updated_at") @db.Timestamptz(3)

  @@index([userId, referenceMonth, type, date, createdAt, id], map: "entries_owner_month_type_date_idx")
  @@index([userId, referenceMonth, type, status], map: "entries_owner_month_type_status_idx")
  @@index([cardId, referenceMonth, status], map: "entries_card_month_status_idx")
  @@index([userId, categoryKey, createdAt, id], map: "entries_owner_category_key_created_idx")
  @@map("entries")
}
