{
  "name": "mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "prebuild": "expo prebuild --platform ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.rules.json",
    "test:rules": "vitest run",
    "test:ui": "TZ=America/Sao_Paulo jest",
    "test": "npm run test:rules && npm run test:ui",
    "check:shared": "node scripts/check-shared-rules.mjs",
    "sync:shared": "node scripts/sync-shared.mjs",
    "check:all": "npm run lint && npm run typecheck && npm run check:shared && npm test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@expo/metro-runtime": "^58.0.16",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "~5.105.2",
    "eslint-config-expo": "~58.0.4",
    "expo": "~58.0.22",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "^58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "^58.0.15",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "^58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-gifted-charts": "^1.4.81",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "^4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "~13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@vitest/coverage-v8": "~4.1.12",
    "eslint": "^9.39.5",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "msw": "~2.15.0",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "vitest": "~4.1.12"
  },
  "overrides": {
    "react-dom": "19.3.0",
    "expo-router": {
      "@testing-library/react-native": "$@testing-library/react-native"
    }
  }
}
